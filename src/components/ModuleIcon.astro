---
// Module icon: the SVG logo if one exists in src/lib/icons.ts,
// otherwise the short text from the `code` field (k8s, tf, 日…).
import { moduleIcons } from '../lib/icons';
interface Props { id: string; code: string; style?: string }
const { id, code, style } = Astro.props;
const svg = moduleIcons[id];
---
<div class="module-icon" style={style}>{svg ? <Fragment set:html={svg} /> : code}</div>
