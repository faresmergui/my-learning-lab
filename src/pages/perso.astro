---
import Base from '../layouts/Base.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getModules, getFiches, moduleOf } from '../lib/content';
const modules = await getModules('perso');
const fiches = await getFiches();
const count = (slug: string) => fiches.filter((f) => moduleOf(f) === slug).length;
---
<Base title="Perso" universe="perso" nav="perso">
  <div class="perso-hero">
    <div>
      <div class="eyebrow rise">univers 02 · perso</div>
      <h1 class="rise" style="--i:1">Prendre le temps d'apprendre</h1>
      <p class="lead rise" style="--i:2">Un espace plus calme, pour ce qui ne relève pas du travail.</p>
    </div>
    <div class="hanko">学</div>
  </div>
  <div class="section grid modules">
    {modules.map((m, i) => <ModuleCard mod={m} fiches={count(m.id)} i={i + 3} />)}
  </div>
</Base>
