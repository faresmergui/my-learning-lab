---
// Shared shell for every page: sidebar, ⌘K palette, fonts,
// and the content index used by the counters.
import { url } from '../lib/url';
import '../styles/global.css';
import Palette from '../components/Palette.astro';

interface Props {
  title: string;
  description?: string;
  universe?: 'tech' | 'perso';
  nav?: 'home' | 'tech' | 'perso' | 'progression' | 'syntheses' | 'certifications' | 'reviser' | 'quiz';
}
const { title, description = 'Mon site pour apprendre et réviser : fiches, flashcards à répétition espacée et quiz, en tech (Kubernetes, Linux, OpenStack…) et en perso.', universe = 'tech', nav } = Astro.props;

const links = [
  { id: 'home', href: url('/'), label: 'Accueil', icon: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>' },
  { id: 'tech', href: url('/tech/'), label: 'Tech', icon: '<path d="M8 9l-3 3 3 3M16 9l3 3-3 3M13 6l-2 12"/>' },
  { id: 'perso', href: url('/perso/'), label: 'Perso', icon: '<circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16" opacity=".35"/>' },
  { id: 'progression', href: url('/progression/'), label: 'Progression', icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>' },
  { id: 'syntheses', href: url('/syntheses/'), label: 'Synthèses', icon: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/>' },
  { id: 'certifications', href: url('/certifications/'), label: 'Certifications', icon: '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5"/>' },
];
const practice = [
  { id: 'reviser', href: url('/reviser/'), label: 'Réviser', icon: '<rect x="4" y="6" width="13" height="14" rx="2"/><path d="M8 3h11a1 1 0 0 1 1 1v13"/>' },
  { id: 'quiz', href: url('/quiz/'), label: 'Quiz', icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17.5v.01"/>' },
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b0c10" />
  <title>{title} · Learning Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Shippori+Mincho:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class={universe === 'perso' ? 'perso' : ''}>
  <div class="backdrop"></div>
  <div class="app">
    <aside class="side">
      <a class="logo" href={url('/')} style="text-decoration:none"><div class="logo-mark">fm</div><div>learning hub<small>~/apprendre</small></div></a>
      <nav class="nav">
        <div class="nav-label">Navigation</div>
        {links.map((l) => (
          <a href={l.href} class={nav === l.id ? 'active' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={l.icon} />
            <span class="t">{l.label}</span>
          </a>
        ))}
        <div class="nav-label">Pratiquer</div>
        {practice.map((l) => (
          <a href={l.href} class={nav === l.id ? 'active' : ''}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={l.icon} />
            <span class="t">{l.label}</span>
            {l.id === 'reviser' && <span class="count" id="nav-due" hidden>0</span>}
          </a>
        ))}
      </nav>
      <button type="button" class="nav-search" id="open-search-m" aria-label="Rechercher">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <div class="side-foot">
        🔥 Série de <b id="nav-streak">0 jour</b>
        <button type="button" class="kbd-hint" id="open-search"><span>Recherche</span><span><kbd>⌘</kbd> <kbd>K</kbd></span></button>
      </div>
    </aside>
    <main>
      <slot />
    </main>
  </div>
  <Palette />
  <script>
    import { streak } from '../lib/progress';
    import { globalStats, loadIndex } from '../lib/stats';
    for (const id of ['open-search', 'open-search-m']) document.getElementById(id)?.addEventListener('click', () => document.dispatchEvent(new Event('palette:open')));
    loadIndex().then((idx) => {
      const s = globalStats(idx);
      const due = document.getElementById('nav-due')!;
      if (s.due + Math.min(s.fresh, 15) > 0) { due.hidden = false; due.textContent = String(s.due + Math.min(s.fresh, 15)); }
    });
    const n = streak();
    document.getElementById('nav-streak')!.textContent = `${n} jour${n > 1 ? 's' : ''}`;
  </script>
</body>
</html>
